rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation for DocumentPhoto entity
    function isValidDocumentPhoto(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.category is string && data.category.size() <= 100
        && data.imageUrl is string
        && (!('description' in data) || (data.description is string && data.description.size() <= 1000))
        && (!('uploadedAt' in data) || (data.uploadedAt is string && data.uploadedAt.size() <= 100));
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Collection of document photos
    match /documentPhotos/{photoId} {
      allow read: if true;
      allow create: if isValidId(photoId) && isValidDocumentPhoto(incoming());
      allow update: if isValidId(photoId) && isValidDocumentPhoto(incoming());
      allow delete: if isValidId(photoId);
    }
  }
}
